{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "78rem"
    },
    "color": {
      "palette": [
        {
          "slug": "forest",
          "color": "#1e3b2a",
          "name": "Dębowa zieleń"
        },
        {
          "slug": "cream",
          "color": "#f4efe4",
          "name": "Ciepły krem"
        },
        {
          "slug": "paper",
          "color": "#fffdf8",
          "name": "Papier"
        },
        {
          "slug": "terracotta",
          "color": "#bd6b4a",
          "name": "Terakota"
        },
        {
          "slug": "honey",
          "color": "#d8a65d",
          "name": "Miodowy"
        },
        {
          "slug": "ink",
          "color": "#17251c",
          "name": "Atrament"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Avenir Next\", Avenir, \"Segoe UI\", Helvetica, Arial, sans-serif",
          "name": "Dębowa Sans",
          "slug": "debowa-sans"
        },
        {
          "fontFamily": "Iowan Old Style, Baskerville, \"Times New Roman\", serif",
          "name": "Dębowa Serif",
          "slug": "debowa-serif"
        }
      ]
    }
  }
}
